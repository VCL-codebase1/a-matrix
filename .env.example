# Required server-only configuration. Select currently eligible model IDs in
# Google AI Studio; model availability and free-tier quotas can change.
GEMINI_API_KEY=
GEMINI_ROUTINE_MODEL=
GEMINI_COMPLEX_MODEL=

# Embeddings are stored as 768-dimensional vectors in Supabase pgvector.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Supabase server-only database configuration. Use the project URL, not the
# /rest/v1 endpoint. The secret key must never use a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_REQUEST_TIMEOUT_MS=2500

# Catalogue sync tuning. The sync command crawls both public sites, upserts
# editable product/specification rows, and refreshes changed embeddings.
CATALOG_REQUEST_TIMEOUT_MS=25000
CATALOG_REQUEST_DELAY_MS=200
CATALOG_PAGE_CONCURRENCY=3
CATALOG_EMBEDDING_BATCH_SIZE=100

# Optional page bounds for sharded one-off imports. Leave unset for normal
# complete syncs.
# CATALOG_START_PAGE=1
# CATALOG_END_PAGE=100

# Output and input-token budgets.
GEMINI_ROUTINE_MAX_OUTPUT_TOKENS=400
GEMINI_COMPLEX_MAX_OUTPUT_TOKENS=900
GEMINI_ROUTINE_THINKING_LEVEL=minimal
GEMINI_COMPLEX_THINKING_LEVEL=medium
AI_ROUTINE_TARGET_INPUT_TOKENS=3000
AI_ROUTINE_INPUT_BUDGET=6000
AI_COMPLEX_TARGET_INPUT_TOKENS=8000
AI_COMPLEX_INPUT_BUDGET=15000

# Request and quota protection.
AI_REQUEST_TIMEOUT_MS=25000
AI_MAX_RETRIES=1
AI_ANONYMOUS_REQUESTS_PER_HOUR=10
AI_ANONYMOUS_REQUESTS_PER_DAY=50
AI_AUTHENTICATED_REQUESTS_PER_HOUR=40
AI_MAX_CONCURRENT_REQUESTS_PER_USER=1
AI_RESPONSE_CACHE_TTL_SECONDS=300
AI_MAX_MESSAGE_CHARACTERS=8000
AI_MAX_HISTORY_MESSAGES=4

# Reserved limits for a future document-upload flow.
AI_MAX_DOCUMENT_PAGES=10
AI_MAX_DOCUMENT_SIZE_MB=10

# Required only for the protected internal usage endpoint.
AI_ADMIN_TOKEN=
